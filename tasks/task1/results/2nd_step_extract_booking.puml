@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

AddRelTag("oldRelationLine", $lineColor="#ff0000",$textColor="#ff0000", $lineStyle=DashedLine())
AddRelTag("newRelationLine", $lineColor="#00ff00",$textColor="#00ff00", $lineStyle=SolidLine())

LAYOUT_WITH_LEGEND()

System_Boundary(hotelio, "Hotelio Monolith") {

  Component(webApp, "Web application", "")
  Component(apiGateway, "API Gateway", "")

  Container(monolith, "Monolith Application", "Spring Boot", "Legacy app exposing REST endpoints for hotel booking") {
    ' Controllers
    Component(hotelController, "HotelController", "Spring MVC", "/api/hotels")
    Component(promoController, "PromoCodeController", "Spring MVC", "/api/promos")
    Component(reviewController, "ReviewController", "Spring MVC", "/api/reviews")
    Component(userController, "UserController", "Spring MVC", "/api/users")
    Component(bookingController, "BookingController", "Spring MVC", "/api/bookings")

    Component(hotelService, "HotelService", "Java Service", "Retrieves hotel details")
    Component(userService, "UserService", "Java Service", "Validates user status and blacklist")
    Component(promoService, "PromoCodeService", "Java Service", "Applies discounts and rules")
    Component(reviewService, "ReviewService", "Java Service", "Manages hotel reviews")
    Component(bookingService, "BookingService", "Java Service", "Validates and creates bookings")

    ' DB
    ComponentDb(monolithPostgresDB, "Monolith DB", "PostgreSQL", "Stores users, hotels, bookings, reviews, promos")

    ' Controller-Service relations
    Rel(hotelController, hotelService, "Uses")
    Rel(promoController, promoService, "Uses")
    Rel(reviewController, reviewService, "Uses")
    Rel(userController, userService, "Uses")
    Rel(bookingController, bookingService, "Uses", $tags="oldRelationLine")

    ' Service-Service and Service-DB
    Rel(bookingService, monolithPostgresDB, "Reads")
    Rel(userService, monolithPostgresDB, "Reads")
    Rel(hotelService, monolithPostgresDB, "Reads")
    Rel(promoService, monolithPostgresDB, "Reads")
    Rel(reviewService, monolithPostgresDB, "Reads/Writes")
  }

' Micro Services
  Container(bookingContainer, "Booking Container", "Spring Boot", "Microservice app exposing REST endpoint for booking") {
      Component(bookingControllerNew, "BookingController", "Spring MVC", "/api/bookings")
      Component(bookingServiceNew, "BookingService", "Java Service", "Validates and creates bookings")
      ' DB
      ComponentDb(bookingDB, "Booking Service DB", "PostgreSQL", "Stores bookings")
      Rel(bookingServiceNew, bookingDB, "Reads/Writes")
  }

  Rel(bookingService, hotelService, "Calls", $tags="oldRelationLine")
  Rel(bookingService, userService, "Calls", $tags="oldRelationLine")
  Rel(bookingService, promoService, "Calls", $tags="oldRelationLine")
  Rel(bookingService, reviewService, "Calls", $tags="oldRelationLine")

  Rel(bookingServiceNew, hotelController, "Calls", $tags="newRelationLine")
  Rel(bookingServiceNew, userController, "Calls", $tags="newRelationLine")
  Rel(bookingServiceNew, promoController, "Calls", $tags="newRelationLine")
  Rel(bookingServiceNew, reviewController, "Calls", $tags="newRelationLine")
}

Person(user, "User", "Interacts with frontend")

Rel(user, webApp, "Uses")
Rel(webApp, apiGateway, "Calls")
Rel(apiGateway, bookingController, "Calls", $tags="oldRelationLine")
Rel(apiGateway, bookingControllerNew, "Calls", $tags="newRelationLine")
Rel(bookingControllerNew, bookingServiceNew, "Calls")
Rel(apiGateway, hotelController, "Calls")
Rel(apiGateway, promoController, "Calls")
Rel(apiGateway, reviewController, "Calls")
Rel(apiGateway, userController, "Calls")

BiRel(monolithPostgresDB, bookingDB, "Взаимная синхронизация бронирований", $tags="newRelationLine")
@enduml